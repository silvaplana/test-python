# Authentification (mot de passe unique partage entre quelques
# utilisateurs, pas de comptes individuels -- voir src/auth/). Hash
# bcrypt a generer UNE FOIS avec :
#   cd backend && source venv/bin/activate && python -m auth.generate_password_hash
# Sert aussi de secret de signature du cookie de session (voir
# src/auth/auth.py) : le changer deconnecte tout le monde, comportement
# voulu.
#
# PIEGE Docker Compose (VPS uniquement, pas en dev local avec
# uvicorn/python-dotenv) : docker-compose interpole les "$" de ce fichier
# comme des references de variable ("$2b" -> variable "2b", etc.), ce qui
# corrompt silencieusement un hash bcrypt (aucune erreur au demarrage,
# juste un mot de passe qui ne fonctionne plus jamais). Sur le VPS,
# doubler chaque "$" du hash colle ("$" -> "$$") avant de le coller ici.
# Repere en verifiant depuis le conteneur :
#   docker exec test-python-backend-1 sh -c 'echo -n "$APP_PASSWORD_HASH" | wc -c'
# doit renvoyer 60 (longueur d'un hash bcrypt $2b$..., non echappe).
APP_PASSWORD_HASH=

# Identifiants OAuth2 de l'application HelloAsso (https://api.helloasso.com)
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=

# Slug technique de l'organisation a interroger (optionnel, requis pour get_organization/get_forms).
# Attention : c'est le slug de l'URL du back-office (admin.helloasso.com/<slug>/accueil),
# qui peut differer du slug affiche sur la page publique (helloasso.com/associations/<autre-slug>).
HELLOASSO_ORGANIZATION_SLUG=

# "1" pour utiliser l'environnement de bac a sable (api.helloasso-sandbox.com)
HELLOASSO_SANDBOX=0

# Slug du formulaire d'adhesion expose par /helloasso/members et /helloasso/unpaid.
# Attention : le slug genere par HelloAsso ne suit pas toujours le titre du
# formulaire (celui-ci est titre "saison 2026-2027" mais garde un slug
# "2025-2026-2-2", HelloAsso ayant ajoute ce suffixe pour eviter un doublon
# avec le slug de la saison precedente) -- verifier via GET /helloasso/campaign
# apres tout changement de saison, plutot que de deviner le slug.
HELLOASSO_FORM_SLUG=rejoignez-notre-club-de-sambo-mma-pour-la-saison-2025-2026-2-2

# Identifiant du portail FFST (ffst-licences.com), saisi en 3 champs sur le
# site (vraisemblablement ligue / departement / n° d'affiliation du club)
FFST_USER_PART1=
FFST_USER_PART2=
FFST_USER_PART3=
FFST_PASSWORD=

# Cle API Anthropic (https://console.anthropic.com), utilisee par
# /financialbalance/analysis pour l'analyse IA des releves bancaires.
# Cree un compte, ajoute un moyen de paiement, genere une cle "sk-ant-...".
# Sans cette variable, l'upload d'archive fonctionne toujours mais
# l'analyse echoue proprement (message d'erreur clair, pas de crash).
ANTHROPIC_API_KEY=

# Paire de cles VAPID (notifications push "nouvel adherent", voir
# src/notifications/). A generer UNE SEULE FOIS pour le club (les
# regenerer invalide tous les abonnements existants) :
#   cd backend && source venv/bin/activate && python -m notifications.generate_vapid_keys
# VAPID_SUBJECT : email ou URL de contact, transmis aux services de push
# (Google/Apple/Mozilla) en cas d'abus signale -- jamais affiche dans l'appli.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Intervalle (secondes) entre 2 verifications de nouveaux adherents
# HelloAsso (polling, voir _poll_new_members dans app/main.py). 300 par
# defaut (5 min) si absent.
NOTIFICATIONS_POLL_INTERVAL_SECONDS=300
