# Authentification (mot de passe unique partage entre quelques
# utilisateurs, pas de comptes individuels -- voir src/auth/). Hash
# bcrypt a generer UNE FOIS avec :
#   cd backend && source venv/bin/activate && python -m auth.generate_password_hash
# Sert aussi de secret de signature du cookie de session (voir
# src/auth/auth.py) : le changer deconnecte tout le monde, comportement
# voulu.
#
# PIEGE Docker Compose (VPS uniquement, pas en dev local avec
# uvicorn/python-dotenv) : docker-compose interpole les "$" de ce fichier
# comme des references de variable ("$2b" -> variable "2b", etc.), ce qui
# corrompt silencieusement un hash bcrypt (aucune erreur au demarrage,
# juste un mot de passe qui ne fonctionne plus jamais). Sur le VPS,
# doubler chaque "$" du hash colle ("$" -> "$$") avant de le coller ici.
# Repere en verifiant depuis le conteneur :
#   docker exec test-python-backend-1 sh -c 'echo -n "$APP_PASSWORD_HASH" | wc -c'
# doit renvoyer 60 (longueur d'un hash bcrypt $2b$..., non echappe).
APP_PASSWORD_HASH=

# 2e niveau d'acces : mot de passe qui, en plus de tout le reste, donne
# acces a l'onglet Finances/Comptes (donnees bancaires, voir
# src/bankaccounts/). Sans lui (ou si cette variable est vide), personne ne
# peut acceder aux comptes. A generer avec :
#   python -m auth.generate_password_hash --accounts
# Meme piege Docker Compose que ci-dessus : doubler chaque "$" sur le VPS.
APP_ACCOUNTS_PASSWORD_HASH=

# Identifiants OAuth2 de l'application HelloAsso (https://api.helloasso.com)
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=

# Slug technique de l'organisation a interroger (optionnel, requis pour get_organization/get_forms).
# Attention : c'est le slug de l'URL du back-office (admin.helloasso.com/<slug>/accueil),
# qui peut differer du slug affiche sur la page publique (helloasso.com/associations/<autre-slug>).
HELLOASSO_ORGANIZATION_SLUG=

# "1" pour utiliser l'environnement de bac a sable (api.helloasso-sandbox.com)
HELLOASSO_SANDBOX=0

# Slug du formulaire d'adhesion expose par /helloasso/members et /helloasso/unpaid.
# Attention : le slug genere par HelloAsso ne suit pas toujours le titre du
# formulaire (celui-ci est titre "saison 2026-2027" mais garde un slug
# "2025-2026-2-2", HelloAsso ayant ajoute ce suffixe pour eviter un doublon
# avec le slug de la saison precedente) -- verifier via GET /helloasso/campaign
# apres tout changement de saison, plutot que de deviner le slug.
HELLOASSO_FORM_SLUG=rejoignez-notre-club-de-sambo-mma-pour-la-saison-2025-2026-2-2

# Identifiant du portail FFST (ffst-licences.com), saisi en 3 champs sur le
# site (vraisemblablement ligue / departement / n° d'affiliation du club)
FFST_USER_PART1=
FFST_USER_PART2=
FFST_USER_PART3=
FFST_PASSWORD=

# Cle API Anthropic (https://console.anthropic.com), utilisee par l'onglet
# Finances : bilan financier, assemblees generales et previsionnel (voir
# financialreports/ai.py). Cree un compte, ajoute un moyen de paiement,
# genere une cle "sk-ant-...". Sans cette variable, un calcul echoue
# proprement (message d'erreur clair, pas de crash).
ANTHROPIC_API_KEY=

# Paire de cles VAPID (notifications push "nouvel adherent", voir
# src/notifications/). A generer UNE SEULE FOIS pour le club (les
# regenerer invalide tous les abonnements existants) :
#   cd backend && source venv/bin/activate && python -m notifications.generate_vapid_keys
# VAPID_SUBJECT : email ou URL de contact, transmis aux services de push
# (Google/Apple/Mozilla) en cas d'abus signale -- jamais affiche dans l'appli.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Intervalle (secondes) entre 2 verifications de nouveaux adherents
# HelloAsso (polling, voir _poll_new_members dans app/main.py). 300 par
# defaut (5 min) si absent.
NOTIFICATIONS_POLL_INTERVAL_SECONDS=300

# Enable Banking (agregateur bancaire PSD2, onglet Finances/Comptes, voir
# src/bankaccounts/). Sans APP_ID/KEY_PATH : mode DEMO (donnees inventees).
# App ID et cle privee .pem : Control Panel https://enablebanking.com/cp
# (la cle n'est JAMAIS commitee : dossier backend/secrets/, ignore par Git,
# monte en lecture seule dans le conteneur, voir docker-compose.yml).
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEY_PATH=
# URL de retour apres autorisation chez la banque : doit etre declaree
# a l'identique dans l'application Enable Banking (HTTPS obligatoire).
ENABLE_BANKING_REDIRECT_URL=https://silvaplana.cloud/sambo-admin/
# Banque et type de compte (voir GET /aspsps de l'API) : a modifier pour changer
# de banque, puis se reconnecter depuis l'onglet Comptes. Le nom doit etre
# exactement celui de la liste Enable Banking (accents et majuscules compris).
# PSU_TYPE : "business" si l'acces se fait par l'espace pro/associations.
ENABLE_BANKING_ASPSP_NAME=Crédit Mutuel
ENABLE_BANKING_ASPSP_COUNTRY=FR
ENABLE_BANKING_PSU_TYPE=personal
# Comptes a afficher dans Finances/Comptes, dans l'ordre : "fin_IBAN=Libelle"
# separes par ";" (les 4 derniers chiffres de l'IBAN suffisent). Vide : tous
# les comptes ayant un IBAN (les cartes bancaires en sont exclues).
BANKACCOUNTS_DISPLAY=1234=Compte courant;5678=Livret

# Mails (page d'inscription au cours d'essai, voir src/mailer/) : envoyes par
# SMTP. Gmail : SMTP_USER = l'adresse Gmail, SMTP_PASSWORD = un "mot de passe
# d'application" (https://myaccount.google.com/apppasswords, validation en 2
# etapes requise) -- jamais le vrai mot de passe du compte. Sans
# SMTP_USER/SMTP_PASSWORD : aucun mail envoye. MAIL_SENDER : adresse
# d'expedition (vide = SMTP_USER).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_SENDER=
MAIL_SENDER_NAME=Alliance Sambo Combat La Ciotat
# CONTACT_ASSOCIATION : adresse de l'association, la seule a regler pour tout
# ce qui revient au club (reponses des eleves a l'essai et des adherents,
# copie des mails aux adherents, alertes de la verification des dossiers).
# Remplace l'ancien MAIL_REPLY_TO, encore lu a defaut.
CONTACT_ASSOCIATION=
# Mails envoyes a un adherent depuis l'onglet HelloAsso > Adherents :
# MEMBERS_MAIL_SENDER, adresse d'expedition de ces mails (defaut : sambo-admin@silvaplana.cloud). Cette
# adresse doit etre un expediteur autorise du service SMTP : avec Brevo
# (SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER = identifiant
# SMTP Brevo, SMTP_PASSWORD = cle SMTP Brevo), l'ajouter dans
# "Expediteurs" ; avec Gmail, l'adresse du compte la remplace.
MEMBERS_MAIL_SENDER=sambo-admin@silvaplana.cloud
# Modele d'IA de la verification du dossier des adherents (onglet HelloAsso >
# Adherents) : haiku, sonnet (defaut) ou fable. Utilise ANTHROPIC_API_KEY.
MEMBER_CHECK_MODEL=sonnet
# Adresse publique du site (contenue dans le QR code des cours d'essai).
PUBLIC_BASE_URL=https://silvaplana.cloud
