# Identifiants OAuth2 de l'application HelloAsso (https://api.helloasso.com)
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=

# Slug technique de l'organisation a interroger (optionnel, requis pour get_organization/get_forms).
# Attention : c'est le slug de l'URL du back-office (admin.helloasso.com/<slug>/accueil),
# qui peut differer du slug affiche sur la page publique (helloasso.com/associations/<autre-slug>).
HELLOASSO_ORGANIZATION_SLUG=

# "1" pour utiliser l'environnement de bac a sable (api.helloasso-sandbox.com)
HELLOASSO_SANDBOX=0

# Slug du formulaire d'adhesion expose par /helloasso/members et /helloasso/unpaid
HELLOASSO_FORM_SLUG=rejoignez-notre-club-de-sambo-mma-pour-la-saison-2025-2026

# Identifiant du portail FFST (ffst-licences.com), saisi en 3 champs sur le
# site (vraisemblablement ligue / departement / n° d'affiliation du club)
FFST_USER_PART1=
FFST_USER_PART2=
FFST_USER_PART3=
FFST_PASSWORD=
